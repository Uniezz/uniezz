{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".prettierrc.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "*.tsbuildinfo"],
      "env": ["NEXT_PUBLIC_*", "NODE_ENV"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "*.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "SUPABASE_*", "NEXT_PUBLIC_*", "API_URL", "FRONTEND_URL"]
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["PORT", "SUPABASE_*", "API_URL", "FRONTEND_URL"]
    }
  }
}
